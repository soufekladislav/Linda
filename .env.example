APP_NAME=Fresh AI Social
APP_VERSION=0.4.8.1
APP_URL=https://socialmedia.freshcrackers.cz
TIMEZONE=Europe/Prague

# Existing Linda database - DO NOT create a new DB for migration.
# Either set DATABASE_URL or the DB_* variables below.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fresh_ai_social
DB_USER=fresh_ai_social
DB_PASSWORD=
DB_CHARSET=utf8mb4

SESSION_SECRET=CHANGE_ME_64_HEX
CRON_TOKEN=CHANGE_ME_CRON_TOKEN
MEDIA_SIGNING_KEY=CHANGE_ME_MEDIA_SIGNING_KEY
DEVELOPER_TOKEN=CHANGE_ME_DEVELOPER_TOKEN
REGISTRATION_MODE=open

# Fresh AI Engine + Fresh Key Propojení
# FRESH_ENGINE_API_KEY musí být app-specific klíč Lindy; stejný klíč obsluhuje i projektové Propojení a SSO.
FRESH_ENGINE_URL=https://aiengine.freshcrackers.cz
FRESH_ENGINE_API_KEY=
FRESH_ENGINE_TIMEOUT_SECONDS=180
FRESH_ENGINE_MAX_COST_USD=

# During rollout only. Fresh Core 0.5.0 should make this unnecessary.
FRESH_CORE_LEGACY_FALLBACK=false

# Legacy fallback only. New Facebook/Instagram/LinkedIn/Google OAuth is owned by Fresh Key in AI Engine.
# Keep these empty for new installations; they remain supported only for old locally configured connectors.
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v24.0

# LinkedIn member OAuth. Company-page publishing additionally needs LinkedIn Community Management access
# and a token/author with w_organization_social.
LINKEDIN_VERSION=202609
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_SCOPES=openid profile email w_member_social

# Google Business Profile OAuth (optional; recommended for Google Profile connector)
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=

# Optional e-mail notifications. In-app notifications always work.
EMAIL_NOTIFICATIONS=false
MAIL_FROM=
SENDMAIL_PATH=/usr/sbin/sendmail
MEDIA_OPTIMIZE_IMAGES=true
MEDIA_IMAGE_QUALITY=84
MEDIA_MAX_DIMENSION=1600
MEDIA_THUMBNAIL_DIMENSION=720

MEDIA_OPTIMIZE_VIDEOS=true
MEDIA_VIDEO_CRF=28
MEDIA_VIDEO_MAX_DIMENSION=1920
MEDIA_MAINTENANCE_BATCH=12
MEDIA_MAINTENANCE_DAYS=1
